  "scripts": {
    "dev": "node --require ./scripts/exfat-readlink-fix.cjs node_modules/next/dist/bin/next dev",
    "build": "node --require ./scripts/exfat-readlink-fix.cjs node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/exfat-readlink-fix.cjs node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/db/setup.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env.local --import tsx scripts/db/reset.ts",
    "db:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/db/preflight.ts",
    "db:create-admin": "node --env-file-if-exists=.env.local --import tsx scripts/db/create-admin.ts",
    "db:set-temp-password": "node --env-file-if-exists=.env.local --import tsx scripts/db/set-temp-password.ts"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
