{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "author": "Kalpojyoti Koch <kalpokoch@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.mongo.local --require ./scripts/exfat-readlink-fix.cjs node_modules/next/dist/bin/next dev",
    "build": "node --require ./scripts/exfat-readlink-fix.cjs node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/exfat-readlink-fix.cjs node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "db:bootstrap": "node --import tsx scripts/mongo/setup-auth.mts --bootstrap",
    "db:setup": "node --import tsx scripts/mongo/setup-auth.mts",
    "db:migrate": "node --import tsx scripts/mongo/migrate.mts",
    "db:seed": "node --import tsx scripts/mongo/seed-accounts.mts",
    "db:reset": "node --import tsx scripts/mongo/reset.mts",
    "db:preflight": "node --import tsx scripts/mongo/preflight.mts",
    "db:create-admin": "node --import tsx scripts/mongo/create-admin.mts",
    "db:set-temp-password": "node --import tsx scripts/mongo/set-temp-password.mts",
    "db:backup": "node --import tsx scripts/mongo/backup.mts",
    "db:restore": "node --import tsx scripts/mongo/restore.mts",
    "db:check": "node --import tsx scripts/mongo/check-infra.mts && node --import tsx scripts/mongo/check-foundation.mts",
    "db:init-replica-set": "node --import tsx scripts/mongo/init-replica-set.mts",
    "db:counts": "node --import tsx scripts/mongo/counts.mts",
    "db:drop-scratch": "node --import tsx scripts/mongo/drop-scratch.mts",
    "db:move": "node --import tsx scripts/mongo/move-from-postgres.mts",
    "db:check-moved": "node --import tsx scripts/mongo/check-moved.mts"
  },
  "dependencies": {
    "bson": "^7.3.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.7.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
