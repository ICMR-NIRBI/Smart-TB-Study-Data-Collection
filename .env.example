# Copy to .env.local and replace every <...> value. Never commit .env.local.

# Local PostgreSQL superuser — used only by `npm run db:setup` to create the database and roles.
PG_ADMIN_URL=postgres://postgres:<superuser-password>@localhost:5432/postgres

# Owns the schema and runs migrations (`npm run db:migrate`, `npm run db:reset`).
DATABASE_OWNER_URL=postgres://smarttb_owner:<owner-password>@localhost:5432/smarttb

# What the web app connects as: can read and write study data, cannot delete it or alter the audit log.
DATABASE_URL=postgres://smarttb_app:<app-password>@localhost:5432/smarttb

# Encrypts participant phone and address (at least 32 characters). Losing it makes stored contacts unreadable.
CONTACT_ENC_KEY=<random-48-characters>

# Password given to the local demo/test accounts by `npm run db:reset`.
DEV_SEED_PASSWORD=<choose-a-local-test-password>

# Testing phase only: one-tap sign-in to the @smarttb.study test accounts, no password. Must be false before real data.
ALLOW_TEST_LOGIN=false
