[Unit]
Description=SMART-TB CRF web application
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=smarttb
Group=smarttb
WorkingDirectory=/opt/smarttb/app
EnvironmentFile=/opt/smarttb/.env
# The MongoDB addresses. Read by systemd directly (they contain "&", so never source this file in a shell).
EnvironmentFile=/opt/smarttb/.env.mongo
Environment=NODE_ENV=production
# Module 5 photos (the picture files; the database keeps a record of each)
Environment=SMARTTB_UPLOAD_DIR=/opt/smarttb/uploads
# Listens on localhost only; Caddy is the only thing exposed to the internet.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smarttb/app/.next /opt/smarttb/uploads
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
