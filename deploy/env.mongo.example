# /opt/smarttb/.env.mongo on the server (mode 600, owner smarttb). Created for you by deploy/mongo-init.sh; this file
# only shows what it contains. Never commit a filled-in copy and never `source` it in a shell (the addresses contain "&").
# Passwords are generated by the script and are never shown on screen.

# The app logs in as this: it can read and write the study data, only ADD to the audit trail, and cannot delete
# participants, create collections or reach any other database.
MONGODB_URI=mongodb://smarttb_app:<generated>@127.0.0.1:27017/smarttb?replicaSet=rs0&authSource=admin
# Used by db:migrate, backups and restores. Never by the running app.
MONGODB_OWNER_URI=mongodb://smarttb_owner:<generated>@127.0.0.1:27017/smarttb?replicaSet=rs0&authSource=admin
MONGODB_DB=smarttb
# Only for setting the logins up again (db:setup). Keep this file at mode 600.
MONGO_ADMIN_URI=mongodb://smarttb_root:<generated>@127.0.0.1:27017/admin?replicaSet=rs0&authSource=admin
