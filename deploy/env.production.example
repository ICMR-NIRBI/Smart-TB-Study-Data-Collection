# /opt/smarttb/.env on the server (mode 640, root:smarttb). Never commit the filled-in copy.
# Plain KEY=value lines, no quotes or spaces: read by systemd and by the deploy/backup scripts.
#
# The MongoDB addresses are NOT here. They live in /opt/smarttb/.env.mongo (mode 600, owner smarttb), created by
# deploy/mongo-init.sh. They contain "&", so that file must never be loaded with `source`.

# Public address of the app (used in setup links printed by db:create-admin).
APP_BASE_URL=https://smarttb.example.in

# Encrypts participant phone and address. Generate once (openssl rand -base64 48), keep a copy offline:
# losing it makes stored contacts unreadable. Never change it after real data is entered.
CONTACT_ENC_KEY=<random-48-characters>

# --- Phase switches ---------------------------------------------------------
# Testing by IP before the domain exists: false. With the domain and HTTPS: true.
COOKIE_SECURE=true
# One-tap sign-in to @smarttb.study test accounts. MUST be false before real data.
ALLOW_TEST_LOGIN=false
# Lifts module locks for page review. Read at build time: redeploy after changing. MUST be false before real data.
NEXT_PUBLIC_CRF_PREVIEW=false

# --- Backups (deploy/backup.sh) --------------------------------------------
# Encrypts every backup file. Keep a copy offline; without it backups cannot be restored.
BACKUP_PASSPHRASE=<long-random-passphrase>
# Optional off-server copy to E2E Object Storage; leave these out to keep local copies only.
BACKUP_BUCKET=<eos-bucket-name>
RCLONE_CONFIG_EOS_TYPE=s3
RCLONE_CONFIG_EOS_PROVIDER=Other
RCLONE_CONFIG_EOS_ENDPOINT=<eos-endpoint-from-e2e-dashboard>
RCLONE_CONFIG_EOS_ACCESS_KEY_ID=<eos-access-key>
RCLONE_CONFIG_EOS_SECRET_ACCESS_KEY=<eos-secret-key>
